<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- アプリ基本設定 -->
	<key>CFBundleName</key>
	<string>シフト自動登録</string>

	<!-- マイク使用理由（必須：音声入力のため） -->
	<key>NSMicrophoneUsageDescription</key>
	<string>音声でシフト情報を入力するためにマイクを使用します</string>

	<!-- 音声認識使用理由（必須：SFSpeechRecognizerのため） -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>話した内容をテキストに変換してシフト情報を読み取るために使用します</string>

	<!-- GoogleSignIn コールバックURL（YOUR_CLIENT_ID を実際のクライアントIDに置き換える） -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.YOUR_CLIENT_ID</string>
			</array>
		</dict>
	</array>

	<!-- HTTP通信許可（ローカルバックエンドへのアクセス用） -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- 本番環境ではHTTPSに移行してこのキーを削除すること -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- Google Sign-In クライアントID（YOUR_CLIENT_ID を置き換える） -->
	<key>GIDClientID</key>
	<string>YOUR_CLIENT_ID.apps.googleusercontent.com</string>
</dict>
</plist>
